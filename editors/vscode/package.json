{
  "name": "l-language-support",
  "displayName": "L Language Support",
  "description": "L 语言语法高亮、类与方法 Hover 悬停提示、Ctrl+Click 跳转定义与 CodeLens 引用计数 (PHP级IDE体验)",
  "version": "0.3.0",
  "publisher": "yongyaoli",
  "engines": {
    "vscode": "^1.60.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:l"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "l",
        "aliases": [
          "L",
          "l",
          "LLang"
        ],
        "extensions": [
          ".l"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "l",
        "scopeName": "source.l",
        "path": "./syntaxes/l.tmLanguage.json"
      }
    ]
  }
}
