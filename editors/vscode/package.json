{
  "name": "l-language-support",
  "displayName": "L Language Support",
  "description": "L 语言语法高亮与代码提示扩展 (.l 文件)",
  "version": "0.2.0",
  "publisher": "yongyaoli",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "l",
        "aliases": [
          "L",
          "l",
          "LLang"
        ],
        "extensions": [
          ".l"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "l",
        "scopeName": "source.l",
        "path": "./syntaxes/l.tmLanguage.json"
      }
    ]
  }
}
