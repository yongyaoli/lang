{
  "name": "l-language-support",
  "displayName": "L Language Support",
  "description": "L 语言 (lang) 官方扩展：语法高亮、类与方法 Hover 悬停提示、Ctrl+Click 跳转定义与 CodeLens 引用计数 (PHP级IDE体验)",
  "version": "0.3.0",
  "publisher": "yongyaoli",
  "icon": "./icons/icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yongyaoli/lang.git"
  },
  "homepage": "https://github.com/yongyaoli/lang#readme",
  "bugs": {
    "url": "https://github.com/yongyaoli/lang/issues"
  },
  "keywords": [
    "l",
    "lang",
    "esp32",
    "embedded",
    "iot",
    "micropython"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:l"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "l",
        "aliases": [
          "L",
          "l",
          "LLang"
        ],
        "extensions": [
          ".l"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "l",
        "scopeName": "source.l",
        "path": "./syntaxes/l.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "l-file-icons",
        "label": "L 文件图标",
        "path": "./icons/l-icon-theme.json"
      }
    ]
  }
}
