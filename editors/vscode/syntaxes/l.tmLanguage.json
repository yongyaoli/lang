{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "L",
  "scopeName": "source.l",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#function-declarations" },
    { "include": "#variable-declarations" },
    { "include": "#classes-and-types" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.l",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.l",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.l",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.l",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.l",
              "match": "\\\\([\"'\\\\/bfnrt]|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2})"
            }
          ]
        },
        {
          "name": "string.quoted.single.l",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.l",
              "match": "\\\\([\"'\\\\/bfnrt]|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.l",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.l",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.l",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.l",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.l" },
            "2": { "name": "entity.name.function.l" }
          }
        }
      ]
    },
    "variable-declarations": {
      "patterns": [
        {
          "match": "\\b(var|let|const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.variable.l" },
            "2": { "name": "variable.other.declaration.l" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.l",
          "match": "\\b(if|else|while|for|in|return|break|continue|try|catch|throw)\\b"
        },
        {
          "name": "keyword.other.l",
          "match": "\\b(import|as|from|export|global)\\b"
        },
        {
          "name": "storage.type.l",
          "match": "\\b(fn|var|let|const|class)\\b"
        }
      ]
    },
    "classes-and-types": {
      "patterns": [
        {
          "name": "entity.name.type.class.l",
          "match": "\\b(ESP32|Pin|PWM|ADC|DAC|I2C|SPI|UART|WiFi|HTTP|SNTP|Math|Time|File|Sys|Net|Core|Hook|[A-Z][a-zA-Z0-9_]*)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.member.l" }
          }
        },
        {
          "match": "(?<=::)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.member.l" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.l" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.l",
          "match": "(&&|\\|\\||!|\\b(and|or|not)\\b)"
        },
        {
          "name": "keyword.operator.comparison.l",
          "match": "(===|==|!==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.l",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|>>=|<<=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.l",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.bitwise.l",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.arrow.l",
          "match": "(->|=>)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.l",
          "match": "\\b(true|false|nil|null|nan|inf|PI|E)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.l",
          "match": "\\b(print|println|printf|help|exit|quit|len|type|str|num|ports|upload|connect|pin|wifi_connect|wifi_disconnect|wifi_is_connected|wifi_ip|wifi_mac|wifi_ssid|wifi_ap|wifi_scan|http_get|http_post|sntp_sync|time|date|datetime|io_exists|io_remove|io_read_lines|io_append|io_size|io_isdir|io_mkdir|io_rmdir|io_rename|io_copy|io_listdir|io_join|io_basename|io_dirname|io_ext|sys_args|sys_platform|sys_version|sys_getenv|sys_setenv|sys_cwd|sys_chdir|sys_pid|sys_script|sys_exec|sys_gc_collect|sys_allocated)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.scope.l",
          "match": "::"
        },
        {
          "name": "punctuation.accessor.dot.l",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.l",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.l",
          "match": ";"
        },
        {
          "name": "punctuation.bracket.l",
          "match": "[\\(\\)\\[\\]\\{\\}]"
        }
      ]
    }
  }
}
