{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "L",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.l",
          "match": "//.*$"
        },
        {
          "name": "comment.block.l",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.l",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.l",
              "match": "\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.l",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.l",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.l",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.l",
          "match": "\\b(if|else|while|for|return|try|catch|throw)\\b"
        },
        {
          "name": "storage.type.l",
          "match": "\\b(let|const|fn|import|as)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.l",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.comparison.l",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.l",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.arithmetic.l",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.bitwise.l",
          "match": "(&|\\||\\^|~|<<|>>)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.l",
          "match": "\\b(true|false|nil|null|PI|E)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.class.l",
          "match": "\\b(ESP32|Pin|PWM|ADC|I2C|SPI|UART|WiFi|HTTP|bytes)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.l",
          "match": "\\b(print|help|exit|quit|len|type|str|num|ports|upload|connect|pin|wifi_connect|wifi_disconnect|wifi_is_connected|wifi_ip|wifi_mac|wifi_ap|wifi_scan|http_get|http_post|sntp_sync|time|date|datetime|io_exists|io_remove|io_read_lines|io_append|io_size|io_isdir|io_mkdir|io_rmdir|io_rename|io_copy|io_listdir|io_join|io_basename|io_dirname|io_ext|sys_args|sys_platform|sys_version|sys_getenv|sys_setenv|sys_cwd|sys_chdir|sys_pid|sys_script|sys_exec|sys_gc_collect|sys_allocated)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.l" }
          }
        }
      ]
    }
  }
}
