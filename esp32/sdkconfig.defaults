# L 语言 ESP32 底包固件默认配置 (ESP-IDF v5.x)
#
# ESP32.watchdog_enable() 依赖 esp_task_wdt API。该模块只在
# CONFIG_ESP_TASK_WDT_EN=y 时才会被编入 libesp_system.a，
# 否则链接期报 undefined reference to `esp_task_wdt_init' 等错误
# (GitHub Actions 云端构建曾因此失败)，故这里显式打开。
#
# INIT=n: 不在启动阶段自动开启看门狗，只在脚本调用 ESP32.watchdog_enable()
# 时才初始化，避免监控 idle 任务产生无谓告警。

CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=n

# 启用仓库自定义分区表 (esp32/partitions.csv):
# factory 应用分区 2MB + l_script 裸脚本分区 128KB。
# 不启用时 ESP-IDF 使用默认 "Single factory app" 表 (factory 仅 1MB)，
# 固件超过 1MB 会导致 ninja 报 "app partition is too small" 溢出错误。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 默认 Flash 仅 2MB, 装不下 factory(2MB)+l_script(128KB), 显式按 4MB 处理
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
