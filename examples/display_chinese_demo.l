// ============================================================================
// L 语言 中文显示综合演示示例 (SSD1306 OLED 与 ILI9341 TFT 彩屏)
// 演示内容:
// 1. 加载 16x16 物联网常用中文字库 (font_cn.l)
// 2. SSD1306 OLED 中英文混合排版渲染与点阵导出
// 3. ILI9341 彩屏中英文混合排版、多色彩与等比缩放渲染
// 4. 运行时动态注册生僻字模扩展 (FontCN.register)
// ============================================================================

import "esp32" as hw;
import "./drivers/font_cn.l" as font_cn;
import "./drivers/SSD1306.l" as ssd_lib;
import "./drivers/ILI9341.l" as lcd_lib;

print("========================================");
print("  L 语言 中文字库与双屏显示综合演示");
print("========================================");

// ----------------------------------------------------------------------------
// 1. SSD1306 0.96寸 OLED 屏幕 (128x64 单色) 中文显示演示
// ----------------------------------------------------------------------------
print("\n[1/3] 初始化 SSD1306 OLED 显示屏并排版中文字符串...");
let i2c = hw.I2C(0, 21, 22, 400000);
let oled = ssd_lib.SSD1306(i2c, 0x3C, 128, 64);
oled.init();

// 显示标题与温湿度物联网监测数据
oled.text(0, 0, "物联网网关 v1.0");
oled.text(0, 20, "温度: 26.5℃");
oled.text(0, 38, "湿度: 65％");
oled.text(0, 52, "状态: 运行正常");

print("SSD1306 屏幕缓冲区渲染完成，输出部分点阵 ASCII 预览:");
// 打印第 0~20 行的像素预览 (取前 36 列点阵展示汉字点阵结构)
for (let r = 0; r < 20; r = r + 3) {
    let line_str = "";
    for (let c = 0; c < 36; c = c + 1) {
        let byte_idx = (r / 8) * 128 + c;
        let bit = (oled.buffer[byte_idx] >> (r % 8)) & 1;
        if bit == 1 {
            line_str = line_str + "#";
        } else {
            line_str = line_str + " ";
        }
    }
    print("  行 " + str(r) + ": [" + line_str + "]");
}
print("SSD1306 OLED 中英文混排渲染成功！");

// ----------------------------------------------------------------------------
// 2. ILI9341 2.8寸 TFT 彩屏 (240x320) 中文显示演示
// ----------------------------------------------------------------------------
print("\n[2/3] 初始化 ILI9341 TFT 彩色显示屏...");
let spi = SPI(1, 18, 23, 19, 40000000);
let tft = lcd_lib.ILI9341(spi, 5, 4, 22, 21);

// 清屏为深蓝色背景
tft.clear(lcd_lib.ILI9341_NAVY);

// 中英文混排渲染 (白字/绿字/黄字，支持 1x/2x 缩放)
tft.text("华为云与阿里云 IoT", 10, 10, lcd_lib.ILI9341_WHITE, lcd_lib.ILI9341_NAVY, 1);
tft.text("设备: 传感器节点-01", 10, 35, lcd_lib.ILI9341_GREEN, lcd_lib.ILI9341_NAVY, 1);
tft.text("网络: 蓝牙/WiFi 正常", 10, 60, lcd_lib.ILI9341_CYAN, lcd_lib.ILI9341_NAVY, 1);
tft.text("电压: 3.3V 高电平", 10, 85, lcd_lib.ILI9341_YELLOW, lcd_lib.ILI9341_NAVY, 1);

print("ILI9341 彩屏中英文多色混排渲染成功！");

// ----------------------------------------------------------------------------
// 3. 动态注册生僻字模测试
// ----------------------------------------------------------------------------
print("\n[3/3] 演示运行时动态注册字模...");
print("检查是否已包含 '龙' 字: " + str(font_cn.FontCN.has("龙")));

// 动态注册 '龙' 字模 (16x16 uint16 点阵)
let custom_long_matrix = [
    0x0200, 0x0200, 0x7FFE, 0x0200, 
    0x0200, 0x0FF8, 0x0888, 0x0888, 
    0x0FF8, 0x0888, 0x0888, 0x0FF8, 
    0x088A, 0x088A, 0x07FE, 0x0000
];
font_cn.FontCN.register("龙", custom_long_matrix);
print("注册后检查 '龙' 字: " + str(font_cn.FontCN.has("龙")));

if font_cn.FontCN.has("龙") {
    print("动态字模扩展验证成功！");
}

print("\n========================================");
print("  中文显示与字库综合演示全部顺利完成！");
print("========================================");
