// 动态字模扩展注册表 (支持开发者在运行时动态注入新的生僻汉字点阵)
let s_custom_font_table = {};

// 注册自定义汉字模 (char: 单个汉字字符, matrix: 16 个 uint16 整数的数组)
fn font_register_cn(ch, matrix) {
    if len(matrix) == 16 {
        s_custom_font_table[ch] = matrix;
    }
}

// 查询字符对应的 16x16 点阵数据 (找不到返回 nil)
fn font_get_cn(ch) {
    let m = s_custom_font_table[ch];
    if m != nil { return m; }
    return FONT16x16_TABLE[ch];
}

// 导出中文字模管理模块
let FontCN = {
    "get": font_get_cn,
    "register": font_register_cn,
    "has": fn(ch) {
        return (font_get_cn(ch) != nil);
    }
};
